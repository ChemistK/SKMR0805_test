# ===========================================================
# .gitignore - Git에 올라가면 안 되는 파일/폴더 목록
# 여기 적힌 것들은 git add를 해도 무시(ignore)되어 커밋되지 않습니다.
# ===========================================================

# --- 비밀 키 / 환경 변수 ---
# .env, config.js 안에는 Supabase 토큰 같은 진짜 비밀 값이 들어 있습니다.
# 그대로 올리면 누구나 그 키로 우리 데이터베이스에 접근할 수 있게 됩니다.
.env
.env.*
!.env.example
config.js
*.key
*.pem

# --- 토큰/자격증명이 들어갈 수 있는 설정 파일 ---
# 로컬 개발 도구나 배포 도구가 만드는 설정 파일에는 종종 접근 토큰이 저장됩니다.
.npmrc
.yarnrc
*.secrets.json
credentials.json

# --- node_modules ---
# npm install로 자동 생성되는 라이브러리 폴더입니다.
# 용량이 크고, package.json만 있으면 누구나 다시 설치할 수 있어서 올릴 필요가 없습니다.
node_modules/

# --- OS(운영체제)가 자동으로 만드는 임시 파일 ---
# 내 컴퓨터 환경에서만 의미 있는 파일이라 다른 사람에게는 필요 없고, 저장소만 지저분해집니다.
.DS_Store          # macOS 폴더 정보 파일
Thumbs.db          # Windows 썸네일 캐시 파일
desktop.ini        # Windows 폴더 설정 파일

# --- 에디터/IDE 설정 ---
# 개인 에디터 환경 설정이라 팀원마다 다를 수 있어 공유할 필요가 없습니다.
.vscode/
.idea/

# --- 로그 파일 ---
# 실행 중 남는 기록 파일로, 매번 새로 생기고 공유할 필요가 없습니다.
*.log
